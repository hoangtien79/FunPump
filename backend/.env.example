# Copy this file to .env and fill in real values before running the server

# Server
PORT=5000
NODE_ENV=development

# MongoDB
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/funcoin
MONGODB_URI=mongodb://localhost:27017/funcoin

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Frontend URL (CORS + password reset links)
FRONTEND_URL=http://localhost:3000

# Email (for password reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@funcoin.com

# Admin bootstrap credentials
ADMIN_EMAIL=admin@funcoin.com
ADMIN_PASSWORD=change_this_password
